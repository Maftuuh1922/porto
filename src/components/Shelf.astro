---
// Rak horizontal + panah ‹ › — perilaku sama seperti yuvich
const { label, caption } = Astro.props;
---
<section class="block">
  {caption && <p class="label">{caption}</p>}
  <div class="shelf" data-shelf>
    <div class="shelf-track" role="region" aria-label={label} tabindex="0">
      <slot />
    </div>
    <div class="shelf-nav">
      <button class="shelf-btn" type="button" data-dir="-1" aria-label="Sebelumnya">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"
          ><path d="M8.5 3 4.5 7l4 4" fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </button>
      <button class="shelf-btn" type="button" data-dir="1" aria-label="Berikutnya">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"
          ><path d="M5.5 3 9.5 7l-4 4" fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </button>
      <span class="shelf-pos" data-pos aria-hidden="true">1/1</span>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-shelf]').forEach((shelf) => {
    const track = shelf.querySelector('.shelf-track') as HTMLElement;
    const btns = shelf.querySelectorAll<HTMLButtonElement>('.shelf-btn');
    const nav = shelf.querySelector('.shelf-nav') as HTMLElement;
    const pos = shelf.querySelector('[data-pos]') as HTMLElement | null;
    const step = () => (track.querySelector('.card') as HTMLElement).getBoundingClientRect().width + 16;
    btns.forEach((b) => b.addEventListener('click', () =>
      track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: 'smooth' })));
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      btns[0].disabled = track.scrollLeft <= 2;
      btns[1].disabled = track.scrollLeft >= max;
      if (max <= 0) nav.style.display = 'none';
      if (pos) {
        const s = step() || 1;
        const total = Math.max(1, Math.ceil(max / s) + 1);
        const idx = Math.min(total, Math.max(1, Math.round(track.scrollLeft / s) + 1));
        pos.textContent = `${idx}/${total}`;
      }
    };
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    setTimeout(sync, 60);
    sync();

    /* seret pakai mouse — gerakan sentuh/touch dibiarkan alami */
    let drag: { x: number; left: number; id: number; moved: boolean } | null = null;
    let suppress = false;
    track.addEventListener('click', (ev) => {
      if (suppress) { ev.preventDefault(); ev.stopPropagation(); suppress = false; }
    }, { capture: true });
    track.addEventListener('pointerdown', (e) => {
      suppress = false;
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, left: track.scrollLeft, id: e.pointerId, moved: false };
    });
    track.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x;
      if (Math.abs(dx) < 4) return;
      if (!drag.moved) {
        drag.moved = true;
        track.classList.add('dragging');
        try { track.setPointerCapture(e.pointerId); } catch { /* abaikan */ }
      }
      track.scrollLeft = drag.left - dx;
      sync();
      e.preventDefault();
    });
    const end = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (drag.moved) suppress = true;
      drag = null;
      track.classList.remove('dragging');
      setTimeout(() => { suppress = false; }, 250);
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);
  });
</script>
