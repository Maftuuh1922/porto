---
const { name, href, desc, note, tags = '' } = Astro.props;
---
<figure class="card" data-tags={tags}>
  <div class="card-face" role="group">
    <slot />
    <p class="card-note">{note}</p>
  </div>
  <figcaption class="card-cap">
    <a class="card-name" href={href}>{name}</a>
    <span class="card-desc">{desc}</span>
  </figcaption>
</figure>
