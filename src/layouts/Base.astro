---
import '../styles/global.css';
import { asLang, localePath, stripLang, t } from '../i18n';

const { title = 'Muhammad Maftuh', active = 'index', bg = '', description } = Astro.props;
const lang = asLang(Astro.props.lang ?? Astro.currentLocale);
const T = t(lang);

const DESC = description ?? T.desc;
const is404 = Astro.props.is404 === true;
/* 404 dipakai untuk semua jalur: tombol bahasanya menuju beranda masing-masing */
const path = is404 ? '/' : stripLang(Astro.url.pathname).replace(/(.)\/$/, '$1');
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const pageUrl = abs(localePath(lang, path));
const enUrl = abs(localePath('en', path));
const idUrl = abs(localePath('id', path));
const ogImage = abs('/og.png');

const links = (['index', 'about', 'work', 'now', 'contact'] as const).map((id) => ({
  id,
  href: localePath(lang, id === 'index' ? '/' : `/${id}`),
  label: T.nav[id],
}));
---
<!doctype html>
<html lang={T.htmlLang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={DESC} />
    {!is404 && <link rel="canonical" href={pageUrl} />}
    {!is404 && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!is404 && <link rel="alternate" hreflang="id" href={idUrl} />}
    {!is404 && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <meta name="theme-color" content="#fafaf9" />

    <!-- pratinjau saat tautan dibagikan (Telegram, WhatsApp, LinkedIn, Google) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muhammad Maftuh" />
    <meta property="og:locale" content={T.ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'id_ID' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={DESC} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={T.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Fragment+Mono&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script defer data-domain="porto-maftuh.vercel.app" src="https://plausible.io/js/script.js"></script>
    <!-- tema: jalan sebelum paint pertama supaya tidak ada kedip -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'dark' && t !== 'light') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) {}
      /* bahasa: hanya kalau pembaca pernah memilih lewat tombol EN | ID.
         Tanpa pilihan tersimpan (termasuk mesin pencari) tidak ada pengalihan. */
      try {
        var want = localStorage.getItem('lang');
        var here = document.documentElement.dataset.lang;
        var alt = document.querySelector('link[rel="alternate"][hreflang="' + want + '"]');
        if ((want === 'en' || want === 'id') && want !== here && alt && !navigator.webdriver) {
          location.replace(new URL(alt.getAttribute('href'), location.href).pathname + location.search + location.hash);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    {
      bg && (
        <div class="page-bg" aria-hidden="true" data-hero>
          {(['light', 'dark'] as const).map((m) => (
            <picture>
              <source
                media="(max-width: 640px)"
                srcset={`/art/hero-${m}-m-700.webp 700w, /art/hero-${m}-m-1100.webp 1100w`}
                sizes="100vw"
              />
              <img
                class={`hero-${m}`}
                src={`/art/hero-${m}-1920.webp`}
                srcset={`/art/hero-${m}-1920.webp 1920w, /art/hero-${m}-3200.webp 3200w`}
                sizes="(max-width: 1500px) 1500px, 100vw"
                alt=""
                width="1920"
                height="1072"
                decoding="async"
                fetchpriority={m === 'light' ? 'high' : 'low'}
              />
            </picture>
          ))}
        </div>
      )
    }
    <header>
      <nav class="site-nav" aria-label={T.navLabel}>
        {
          links.map((l) => (
            <a href={l.href} aria-current={l.id === active ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
        <button class="theme-toggle" id="themeToggle" type="button" aria-pressed="false" aria-label={T.themeToggle}>
          <svg class="i-moon" viewBox="0 0 14 14" aria-hidden="true"
            ><path d="M12.2 8.7A5.7 5.7 0 0 1 5.3 1.8a5.7 5.7 0 1 0 6.9 6.9Z" fill="currentColor"></path></svg
          >
          <svg class="i-sun" viewBox="0 0 14 14" aria-hidden="true"
            ><circle cx="7" cy="7" r="3" fill="currentColor"></circle><g stroke="currentColor" stroke-width="1.2" stroke-linecap="round"
              ><path d="M7 1v1.5M7 11.5V13M1 7h1.5M11.5 7H13M2.9 2.9l1 1M10.1 10.1l1 1M11.1 2.9l-1 1M3.9 10.1l-1 1"></path></g
            ></svg
          >
        </button>
        <span class="lang-toggle" role="group" aria-label={T.langLabel}>
          <a href={localePath('en', path)} hreflang="en" lang="en" data-set-lang="en"
            aria-current={lang === 'en' ? 'true' : undefined} title="Read in English">EN</a>
          <span aria-hidden="true">|</span>
          <a href={localePath('id', path)} hreflang="id" lang="id" data-set-lang="id"
            aria-current={lang === 'id' ? 'true' : undefined} title="Baca dalam Bahasa Indonesia">ID</a>
        </span>
      </nav>
    </header>

    <main class="page">
      <slot />
    </main>

    <footer class="site-foot">
      <span>{T.footHello}</span>
      <span class="ticker" id="clock" data-live="1">Bandung, Indonesia</span>
    </footer>

    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((a) =>
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('lang', a.dataset.setLang || 'en');
          } catch (e) {}
        }),
      );
      const el = document.getElementById('clock');
      const tick = () => {
        if (!el) return;
        const t = new Date().toLocaleTimeString(document.documentElement.lang === 'id' ? 'id-ID' : 'en-GB', { timeZone: 'Asia/Jakarta', hour12: false });
        el.textContent = 'Bandung, Indonesia · ' + t + ' WIB';
      };
      tick();
      setInterval(tick, 1000);

      // --- mode gelap ---
      const root = document.documentElement;
      const btn = document.getElementById('themeToggle');
      const applyTheme = (t) => {
        root.dataset.theme = t;
        btn?.setAttribute('aria-pressed', String(t === 'dark'));
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', t === 'dark' ? '#0d0d10' : '#fafaf9');
        try {
          localStorage.setItem('theme', t);
        } catch (e) {}
      };
      applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
      btn?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (err) {}
        if (saved !== 'dark' && saved !== 'light') applyTheme(e.matches ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
