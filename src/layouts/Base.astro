---
import '../styles/global.css';

const { title = 'Muhammad Maftuh', active = 'index', bg = '' } = Astro.props;

const DESC =
  'Muhammad Maftuh — mahasiswa dan pembangun perangkat lunak dari Bandung. NeovarchLabs, Nalar.Ai, BatikLens, dan proyek sumber terbuka lainnya.';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

// garis bawah bergelombang, panjangnya beda tiap label (persis gaya yuvich)
const links = [
  { id: 'index', href: '/', label: 'Index',
    d: 'M1 3.5 q2.75 -1.55 5.50 0 q2.75 2.56 5.50 0 q2.75 -1.87 5.50 0 q2.75 1.78 5.50 0 q2.75 -2.35 5.50 0 q2.75 2.14 5.50 0 q1.73 -1.91 3.47 0',
    w: 38.46875 },
  { id: 'about', href: '/about', label: 'About',
    d: 'M1 3.5 q2.75 -1.55 5.50 0 q2.75 2.24 5.50 0 q2.75 -1.67 5.50 0 q2.75 1.74 5.50 0 q2.75 -2.27 5.50 0 q2.75 1.97 5.50 0 q1.60 -2.19 3.20 0',
    w: 43.703125 },
  { id: 'work', href: '/work', label: 'Work',
    d: 'M1 3.5 q2.75 -1.55 5.50 0 q2.75 1.92 5.50 0 q2.75 -2.58 5.50 0 q2.75 1.70 5.50 0 q2.75 -2.19 5.50 0 q2.75 1.80 5.50 0 q1.57 -2.16 3.14 0',
    w: 38.140625 },
  { id: 'now', href: '/now', label: 'Now',
    d: 'M1 3.5 q2.75 -1.55 5.50 0 q2.75 1.61 5.50 0 q2.75 -2.38 5.50 0 q2.75 1.66 5.50 0 q2.75 -2.11 5.50 0 q0.93 1.63 1.86 0',
    w: 31.359375 },
  { id: 'contact', href: '/contact', label: 'Contact',
    d: 'M1 3.5 q2.75 -1.55 5.50 0 q2.75 2.31 5.50 0 q2.75 -1.74 5.50 0 q2.75 1.69 5.50 0 q2.75 -2.42 5.50 0 q2.75 2.05 5.50 0 q1.66 -2.08 3.32 0',
    w: 51.515625 },
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={DESC} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#fafaf9" />

    <!-- pratinjau saat tautan dibagikan (Telegram, WhatsApp, LinkedIn, Google) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muhammad Maftuh" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={DESC} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Muhammad Maftuh — portofolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Fragment+Mono&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script defer data-domain="porto-maftuh.vercel.app" src="https://plausible.io/js/script.js"></script>
    <!-- tema: jalan sebelum paint pertama supaya tidak ada kedip -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'dark' && t !== 'light') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    {bg && <div class="page-bg" aria-hidden="true" data-hero />}
    <header>
      <nav class="site-nav" aria-label="Pages">
        {
          links.map((l) => (
            <a href={l.href} aria-current={l.id === active ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
        <button class="theme-toggle" id="themeToggle" type="button" aria-pressed="false" aria-label="Ganti mode terang / gelap">
          <svg class="i-moon" viewBox="0 0 14 14" aria-hidden="true"
            ><path d="M12.2 8.7A5.7 5.7 0 0 1 5.3 1.8a5.7 5.7 0 1 0 6.9 6.9Z" fill="currentColor"></path></svg
          >
          <svg class="i-sun" viewBox="0 0 14 14" aria-hidden="true"
            ><circle cx="7" cy="7" r="3" fill="currentColor"></circle><g stroke="currentColor" stroke-width="1.2" stroke-linecap="round"
              ><path d="M7 1v1.5M7 11.5V13M1 7h1.5M11.5 7H13M2.9 2.9l1 1M10.1 10.1l1 1M11.1 2.9l-1 1M3.9 10.1l-1 1"></path></g
            ></svg
          >
        </button>
      </nav>
    </header>

    <main class="page">
      <slot />
    </main>

    <footer class="site-foot">
      <span>salam kenal</span>
      <span class="ticker" id="clock" data-live="1">Bandung, Indonesia</span>
    </footer>

    <script>
      const el = document.getElementById('clock');
      const tick = () => {
        if (!el) return;
        const t = new Date().toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta', hour12: false });
        el.textContent = 'Bandung, Indonesia · ' + t + ' WIB';
      };
      tick();
      setInterval(tick, 1000);

      // --- mode gelap ---
      const root = document.documentElement;
      const btn = document.getElementById('themeToggle');
      const applyTheme = (t) => {
        root.dataset.theme = t;
        btn?.setAttribute('aria-pressed', String(t === 'dark'));
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', t === 'dark' ? '#0d0d10' : '#fafaf9');
        try {
          localStorage.setItem('theme', t);
        } catch (e) {}
      };
      applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
      btn?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (err) {}
        if (saved !== 'dark' && saved !== 'light') applyTheme(e.matches ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
