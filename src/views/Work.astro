---
import Base from '../layouts/Base.astro';
import Shelf from '../components/Shelf.astro';
import Card from '../components/Card.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Heatmap from '../components/Heatmap.astro';
import { projects as all, localize } from '../data/projects';
import { fetchStats } from '../lib/stats';
import { fetchContrib } from '../lib/contrib';
import type { Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const en = lang === 'en';
const projects = all.map((p) => localize(p, lang));

const { stats } = await fetchStats();
const { data: contrib, live: contribLive } = await fetchContrib();
const maxLang = Math.max(1, ...stats.langs.map(([, n]) => n));

const filter = [
  { v: 'all', l: en ? 'All' : 'Semua' },
  { v: 'agent', l: en ? 'AI agents' : 'Agent AI' },
  { v: 'ai', l: 'AI' },
  { v: 'web', l: 'Web' },
  { v: 'linux', l: 'Linux' },
  { v: 'mobile', l: 'Mobile' },
  { v: 'game', l: 'Game' },
  { v: 'ext', l: en ? 'Extensions' : 'Ekstensi' },
].filter((f) => f.v === 'all' || projects.some((p) => p.tags.includes(f.v)));
const unit = en ? 'projects' : 'proyek';
---
<Base title="Work · Muhammad Maftuh" active="work" lang={lang}>
  <section class="prose">
    {
      en ? (
        <p>
          {projects.length} projects I built myself or led — from an AI agent that runs on your own PC and safety tools
          for coding agents to Linux desktop plugins and a Roblox game. Every card uses a real screenshot from the live
          site or its repository; where there isn’t one yet, I leave it blank.
        </p>
      ) : (
        <p>
          {projects.length} proyek yang saya bangun sendiri atau pimpin — dari agen AI yang jalan di PC sendiri, perkakas
          keamanan untuk coding agent, sampai plugin desktop Linux dan game Roblox. Tiap kartu memakai tangkapan layar
          asli dari situs live atau repositorinya; yang belum punya, saya biarkan kosong.
        </p>
      )
    }
  </section>

  <div class="work-wrap">
    <div class="filters" role="group" aria-label={en ? 'Filter work' : 'Saring karya'} data-unit={unit}>
      {
        filter.map((f) => (
          <button type="button" class="filter-btn" data-filter={f.v} aria-pressed={f.v === 'all' ? 'true' : 'false'}>
            {f.l}
          </button>
        ))
      }
      <span class="filter-count" id="filter-count" aria-live="polite">{projects.length} {unit}</span>
    </div>
    <div class="work-grid" id="work-grid">
      {projects.map((p) => <ProjectCard p={p} lang={lang} />)}
    </div>
  </div>

  <Shelf label={en ? 'On GitHub and Hugging Face' : 'Di GitHub dan Hugging Face'} caption={en ? 'On GitHub & Hugging Face' : 'Di GitHub & Hugging Face'} lang={lang}>
    <Card
      name="Hugging Face"
      href="https://huggingface.co/maftuh-main"
      desc={en ? `models, datasets & Spaces · ${stats.models} models` : `model, dataset & Space · ${stats.models} model`}
      note="huggingface.co/maftuh-main"
    >
      <div class="sheet">
        <h4>maftuh-main</h4>
        <div class="row"><span>{en ? 'models' : 'model'}</span><b id="hf-models" data-target={stats.models}>{stats.models}</b></div>
        <div class="row"><span>{en ? 'Spaces' : 'Space'}</span><b id="hf-spaces" data-target={stats.spaces}>{stats.spaces}</b></div>
        <div class="row"><span>{en ? 'datasets' : 'dataset'}</span><b id="hf-data" data-target={stats.datasets}>{stats.datasets}</b></div>
        <div class="row" style="margin-top:6px"><span>{en ? 'flagship' : 'andalan'}</span><b>batik-qwen1.5b</b></div>
      </div>
    </Card>

    <Card
      name={en ? 'GitHub profile' : 'Profil GitHub'}
      href="https://github.com/Maftuuh1922?tab=repositories"
      desc={`Maftuuh1922 · ${stats.followers} followers`}
      note={en ? 'main languages of public repos · counted at build time' : 'bahasa utama repo publik · dihitung saat build'}
    >
      <div class="sheet">
        <h4>{stats.repos} {en ? 'public repositories' : 'repositori publik'}</h4>
        {
          stats.langs.slice(0, 5).map(([l, n]) => (
            <>
              <div class="row"><span>{l}</span><b>{n}</b></div>
              <div class="bar"><i class="lang" data-v={Math.round((n / maxLang) * 100)}></i></div>
            </>
          ))
        }
      </div>
    </Card>
  </Shelf>

  <section class="heat-wrap">
    <p class="label">{en ? 'GitHub contributions — green squares, last 12 months' : 'Kontribusi GitHub — kotak hijau, 12 bulan terakhir'}</p>
    <Heatmap data={contrib} live={contribLive} lang={lang} />
  </section>
</Base>

<script>
  import { bahasa } from '../scripts/demos';
  bahasa();

  const grid = document.getElementById('work-grid');
  const count = document.getElementById('filter-count');
  const unit = (document.querySelector('.filters') as HTMLElement | null)?.dataset.unit ?? '';
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  if (grid) {
    const cards = grid.querySelectorAll<HTMLElement>('.pcard');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter ?? 'all';
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        let n = 0;
        cards.forEach((c) => {
          const on = f === 'all' || (c.dataset.tags ?? '').split(/\s+/).includes(f);
          c.hidden = !on;
          if (on) n++;
        });
        if (count) count.textContent = `${n} ${unit}`;
      }),
    );
  }
</script>
