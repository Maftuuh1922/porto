---
import Base from '../layouts/Base.astro';
import { fetchStats } from '../lib/stats';

const EMAIL = 'maftuhade123@gmail.com';
const { stats } = await fetchStats();

const kanal = [
  { label: 'Email', nilai: EMAIL, href: `mailto:${EMAIL}`, ket: 'balasan paling cepat' },
  { label: 'GitHub', nilai: 'github.com/Maftuuh1922', href: 'https://github.com/Maftuuh1922', ket: `${stats.repos} repositori publik` },
  { label: 'Hugging Face', nilai: 'huggingface.co/maftuh-main', href: 'https://huggingface.co/maftuh-main', ket: `${stats.models} model · ${stats.spaces} Space` },
  { label: 'LinkedIn', nilai: 'in/muhammad-maftuh-798331386', href: 'https://www.linkedin.com/in/muhammad-maftuh-798331386', ket: 'profil & pengalaman' },
];
---
<Base title="Contact · Muhammad Maftuh" active="contact">
  <section class="prose">
    <p class="label">Kontak</p>
    <p>
      Ada proyek, kerja sama, atau sekadar mau ngobrol soal web dan AI? Pilih kanal di bawah —
      email paling cepat saya balas, dan semua tautan mengarah ke akun resmi saya.
    </p>
  </section>

  <section class="block">
    <ul class="contact-list">
      {
        kanal.map((k) => (
          <li>
            <a class="contact-row" href={k.href} target={k.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
              <span class="contact-label">{k.label}</span>
              <span class="contact-value">{k.nilai}</span>
              <span class="contact-note">{k.ket}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block">
    <p class="label">Lampiran</p>
    <a class="btn-cv" href="/cv.pdf" download>
      Unduh CV (PDF)
      <span aria-hidden="true">↓</span>
    </a>
    <p class="cv-note">Ringkasan profil, keahlian, dan proyek pilihan — satu halaman, dibuat dari halaman ini.</p>
  </section>
</Base>
