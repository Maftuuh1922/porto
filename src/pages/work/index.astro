---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import Card from '../../components/Card.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Heatmap from '../../components/Heatmap.astro';
import { projects } from '../../data/projects';
import { fetchStats } from '../../lib/stats';
import { fetchContrib } from '../../lib/contrib';

const { stats } = await fetchStats();
const { data: contrib, live: contribLive } = await fetchContrib();
const maxLang = Math.max(1, ...stats.langs.map(([, n]) => n));

const filter = [
  { v: 'all', l: 'Semua' },
  { v: 'agent', l: 'Agent AI' },
  { v: 'ai', l: 'AI' },
  { v: 'web', l: 'Web' },
  { v: 'linux', l: 'Linux' },
  { v: 'mobile', l: 'Mobile' },
  { v: 'game', l: 'Game' },
  { v: 'ext', l: 'Ekstensi' },
].filter((f) => f.v === 'all' || projects.some((p) => p.tags.includes(f.v)));
---
<Base title="Work · Muhammad Maftuh" active="work">
  <section class="prose">
    <p>
      {projects.length} proyek yang saya bangun sendiri atau pimpin — dari agen AI yang jalan di PC sendiri, perkakas
      keamanan untuk coding agent, sampai plugin desktop Linux dan game Roblox. Tiap kartu memakai tangkapan layar
      asli dari situs live atau repositorinya; yang belum punya, saya biarkan kosong.
    </p>
  </section>

  <div class="work-wrap">
    <div class="filters" role="group" aria-label="Saring karya">
      {
        filter.map((f) => (
          <button type="button" class="filter-btn" data-filter={f.v} aria-pressed={f.v === 'all' ? 'true' : 'false'}>
            {f.l}
          </button>
        ))
      }
      <span class="filter-count" id="filter-count" aria-live="polite">{projects.length} proyek</span>
    </div>
    <div class="work-grid" id="work-grid">
      {projects.map((p) => <ProjectCard p={p} />)}
    </div>
  </div>

  <Shelf label="Di GitHub dan Hugging Face" caption="Di GitHub & Hugging Face">
    <Card
      name="Hugging Face"
      href="https://huggingface.co/maftuh-main"
      desc={`model, dataset & Space · ${stats.models} model`}
      note="huggingface.co/maftuh-main"
    >
      <div class="sheet">
        <h4>maftuh-main</h4>
        <div class="row"><span>model</span><b id="hf-models" data-target={stats.models}>{stats.models}</b></div>
        <div class="row"><span>Space</span><b id="hf-spaces" data-target={stats.spaces}>{stats.spaces}</b></div>
        <div class="row"><span>dataset</span><b id="hf-data" data-target={stats.datasets}>{stats.datasets}</b></div>
        <div class="row" style="margin-top:6px"><span>andalan</span><b>batik-qwen1.5b</b></div>
      </div>
    </Card>

    <Card
      name="Profil GitHub"
      href="https://github.com/Maftuuh1922?tab=repositories"
      desc={`Maftuuh1922 · ${stats.followers} followers`}
      note="bahasa utama repo publik · dihitung saat build"
    >
      <div class="sheet">
        <h4>{stats.repos} repositori publik</h4>
        {
          stats.langs.slice(0, 5).map(([l, n]) => (
            <>
              <div class="row"><span>{l}</span><b>{n}</b></div>
              <div class="bar"><i class="lang" data-v={Math.round((n / maxLang) * 100)}></i></div>
            </>
          ))
        }
      </div>
    </Card>
  </Shelf>

  <section class="heat-wrap">
    <p class="label">Kontribusi GitHub — kotak hijau, 12 bulan terakhir</p>
    <Heatmap data={contrib} live={contribLive} />
  </section>
</Base>

<script>
  import { bahasa } from '../../scripts/demos';
  bahasa();

  const grid = document.getElementById('work-grid');
  const count = document.getElementById('filter-count');
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  if (grid) {
    const cards = grid.querySelectorAll<HTMLElement>('.pcard');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter ?? 'all';
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        let n = 0;
        cards.forEach((c) => {
          const on = f === 'all' || (c.dataset.tags ?? '').split(/\s+/).includes(f);
          c.hidden = !on;
          if (on) n++;
        });
        if (count) count.textContent = `${n} proyek`;
      }),
    );
  }
</script>
