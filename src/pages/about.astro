---
import Base from '../layouts/Base.astro';

/* benda di "meja" — alat & tanda yang benar-benar saya pakai, miring seperti halaman about yuvich.
   tiap benda punya logo sesuai judulnya dan bisa digeser */
const objects = [
  { left: '4%', top: '8px', rot: '-5deg', logo: '/logos/hermes.png', title: 'Hermes', sub: 'agen AI',
    spec: 'otomasi harian · bot Telegram · cron', id: 'o1' },
  { left: '37%', top: '0px', rot: '4deg', logo: '/logos/nextdotjs.svg', title: 'Next.js', sub: 'TypeScript',
    spec: 'NeovarchLabs · situs produksi + invoice PDF', id: 'o2' },
  { left: '69%', top: '26px', rot: '-7deg', logo: '/logos/9router.svg', title: '9router', sub: 'gateway LLM',
    spec: 'gabung 1.500+ model dari belasan penyedia', id: 'o3' },
  { left: '5%', top: '172px', rot: '6deg', logo: '/logos/github.svg', title: 'GitHub', sub: 'Maftuuh1922',
    spec: '48 repositori publik · 10 followers', id: 'o4' },
  { left: '38%', top: '178px', rot: '-4deg', logo: '/logos/flutter.svg', title: 'Flutter', sub: 'Dart',
    spec: 'aplikasi_berita, sales-management, Tunein', id: 'o5' },
  { left: '70%', top: '196px', rot: '8deg', logo: '/logos/python.svg', title: 'Python', sub: 'FastAPI',
    spec: 'Nalar.ai-be · indeks & RAG, 1.204 dokumen', id: 'o6' },
  { left: '6%', top: '336px', rot: '-6deg', logo: '/logos/linux.svg', title: 'Linux', sub: 'VPS',
    spec: 'bot Telegram, gateway 9router, cron', id: 'o7' },
  { left: '40%', top: '348px', rot: '5deg', logo: '/logos/astro.svg', title: 'Astro', sub: 'Tailwind',
    spec: 'situs yang sedang Anda baca ini', id: 'o8' },
  { left: '71%', top: '360px', rot: '-10deg', logo: '/logos/sqlite.svg', title: 'SQLite', sub: 'Turso',
    spec: 'basis data NeovarchLabs', id: 'o9' },
];
---
<Base title="About · Muhammad Maftuh" active="about">
  <section class="wide" aria-label="Alat kerja saya">
    <div class="desk-mat">
      {
        objects.map((o) => (
          <div class="desk-object" id={o.id} style={`left:${o.left};top:${o.top};--rot:${o.rot};`}>
            <div class="chip">
              <img class="chip-logo" src={o.logo} alt="" width="20" height="20" loading="lazy" />
              <span class="chip-txt">
                <b>{o.title}</b>
                <span class="chip-sub">{o.sub}</span>
              </span>
            </div>
            <span class="spec">{o.spec}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="block prose">
    <p>
      Saya <strong style="color:var(--ink)">Muhammad Maftuh</strong>, mahasiswa yang menghabiskan
      waktu di antara kuliah, menulis kode, dan merawat layanan kecil yang dipakai orang lain.
    </p>
    <p>
      Saya bekerja paling nyaman di dekat data dan infrastruktur: API, basis data, otomasi, dan
      sedikit perkakas AI. Di <a class="link" href="https://www.neovarchlabs.web.id">NeovarchLabs</a>
      saya menangani semuanya sendiri — dari desain sampai peluncuran.
    </p>
    <p>
      Karya yang bisa dicoba ada di halaman <a class="link" href="/work">work</a>, dan catatan
      terbaru di <a class="link" href="/now">now</a>.
    </p>
    <p>
      Model, dataset, dan Space yang saya unggah ada di
      <a class="link" href="https://huggingface.co/maftuh-main">huggingface.co/maftuh-main</a> —
      delapan model batik berbasis QLoRA, lima Space, satu dataset sintetis.
    </p>
    <p>
      Ada yang ingin didiskusikan? Sapa saya di
      <a class="link" href="https://github.com/Maftuuh1922">github</a>,
      <a class="link" href="https://huggingface.co/maftuh-main">huggingface</a>, atau
      <a class="link" href="https://www.linkedin.com/in/muhammad-maftuh-798331386">linkedin</a>.
    </p>
  </section>
</Base>
